<app-header></app-header>

<app-hero></app-hero>


<!-- =========================================
     TOP CATEGORIES
========================================= -->

<section class="categories-section">

  <!-- Section heading -->
  <div class="categories-header">

    <h2>Top Categories</h2>

    <a routerLink="/catalogue" class="view-all-btn">
      View All
    </a>

  </div>


  <!-- Categories -->
  <div class="categories-list">


    <!-- ================= DRESSES ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Dresses' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/dresses.jpg"
          alt="Dresses"
        />

      </div>

      <p>Dresses</p>

    </a>


    <!-- ================= LEHENGA ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Lehenga' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/lehenga.jpg"
          alt="Lehenga"
        />

      </div>

      <p>Lehenga</p>

    </a>


    <!-- ================= SAREE ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Saree' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/saree.jpg"
          alt="Saree"
        />

      </div>

      <p>Saree</p>

    </a>


    <!-- ================= INDO WESTERN ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Indo Western' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/indo-western.jpg"
          alt="Indo Western"
        />

      </div>

      <p>Indo Western</p>

    </a>


    <!-- ================= KURTA SET ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Kurta Set' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/kurta-set.jpg"
          alt="Kurta Set"
        />

      </div>

      <p>Kurta Set</p>

    </a>


    <!-- ================= PARTY WEAR ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Party Wear' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/party-wear.jpg"
          alt="Party Wear"
        />

      </div>

      <p>Party Wear</p>

    </a>


    <!-- ================= MEN'S WEAR ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Men\'s Wear' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/mens-wear.jpg"
          alt="Men's Wear"
        />

      </div>

      <p>Men's Wear</p>

    </a>


    <!-- ================= KIDS WEAR ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Kids Wear' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/kids-wear.jpg"
          alt="Kids Wear"
        />

      </div>

      <p>Kids Wear</p>

    </a>


    <!-- ================= JEWELLERY ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Jewellery' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/jewellery.jpg"
          alt="Jewellery"
        />

      </div>

      <p>Jewellery</p>

    </a>


    <!-- ================= ACCESSORIES ================= -->

    <a routerLink="/catalogue" [queryParams]="{ category: 'Accessories' }" class="category-card">

      <div class="category-image">

        <img
          src="/images/accessories.jpg"
          alt="Accessories"
        />

      </div>

      <p>Accessories</p>

    </a>


  </div>

</section>
